# Copy to values.local.env and replace with real values.
# This example file is safe to commit: every value here is fake.
# Format: NAME=value   (one per line; # starts a comment)

ORG_NAME=Example University College of Engineering
ROLE_TITLE=Senior Systems Analyst
STUDENT_ASSISTANTS=3
AD_DOMAIN=EXAMPLE (example.ad.example.edu)
WORKSTATION_ADMIN_GROUP=EXAMPLE\Workstation-Admins
SCRIPTS_PATH=C:\Scripts
BACKUP_PATH=C:\Scripts\BackUp
NETWORK_REGISTRATION=the campus network registration portal (by MAC address)
SERVER_PDM=server01: Windows Server 2022; PDM vault, website, part number app
SERVER_VMHOST=server02: virtual machine host
SERVER_LICENSE=server03: license server VM (Ansys, Autodesk, SOLIDWORKS, others)
SERVER_FILES=server04 (alias fs): file server with install shares under \\fs\share$\
ABAQUS_LICENSE=192.0.2.10 port 27000
